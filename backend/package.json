{
  "name": "deploy-panel-backend",
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "sh scripts/migrate.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/client": "^5.22.0",
    "hono": "^4.13.18",
    "prisma": "^5.22.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "@vitest/coverage-v8": "4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  }
}
