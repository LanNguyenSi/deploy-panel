# Database
POSTGRES_USER=deploy_panel
POSTGRES_PASSWORD=deploy_panel
POSTGRES_DB=deploy_panel

# Backend (local dev, uses docker-compose db)
DATABASE_URL=postgresql://deploy_panel:deploy_panel@localhost:5433/deploy_panel
SESSION_SECRET=change-me-to-a-random-32-char-string!!
PORT=3001
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
NODE_ENV=development

# GitHub OAuth (optional; see docs/configuration.md#authentication)
# Set both to enable the standalone "Sign in with GitHub" flow.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Identity-broker allowlist (optional; empty = any verified GitHub user)
# Comma-separated logins, e.g. ALLOWED_GITHUB_LOGINS=alice,bob
# ALLOWED_GITHUB_LOGINS=

# Per-app secret encryption. Running the backend directly on the host
# (`make dev`) falls back to an insecure fixed dev key with a warning when
# this is unset. Running via `docker compose up` (docker-compose.yml)
# REQUIRES a real value — the compose file has no fallback default on
# purpose, so an unset key fails the backend's startup validation instead of
# silently encrypting secrets with a key anyone can read in this repo.
# Generate one with: openssl rand -hex 32
# APP_SECRETS_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_PORT=3000
