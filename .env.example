# Database
POSTGRES_USER=deploy_panel
POSTGRES_PASSWORD=deploy_panel
POSTGRES_DB=deploy_panel

# Backend (local dev, uses docker-compose db)
DATABASE_URL=postgresql://deploy_panel:deploy_panel@localhost:5433/deploy_panel
# Reserved: nothing reads SESSION_SECRET today and startup does not require
# it. If you set it, it must be at least 16 characters.
# SESSION_SECRET=
PORT=3001
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
# `development` suits a host run (`make dev`). Compose reads this file, and a
# value set here overrides the `production` default in docker-compose.yml:
# remove this line or set NODE_ENV=production in the .env you use for a
# `docker compose` run.
NODE_ENV=development

# GitHub OAuth (optional; see docs/configuration.md#authentication)
# Set both to enable the standalone "Sign in with GitHub" flow.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# GitHub login allowlist (optional in development: empty = any verified GitHub
# user). Applies to the native OAuth login and the identity-broker endpoint.
# Comma-separated logins, e.g. ALLOWED_GITHUB_LOGINS=alice,bob
# Required with NODE_ENV=production: the backend refuses to start when the
# list is empty (unset, empty, or only spaces and commas), including on a
# PANEL_TOKEN-only panel (the identity-broker endpoint is always mounted),
# and docker-compose.yml defaults NODE_ENV to production and this variable to
# empty, so a compose run in production mode needs a real value here.
# ALLOWED_GITHUB_LOGINS=

# Per-app secret encryption. Running the backend directly on the host
# (`make dev`) falls back to an insecure fixed dev key with a warning when
# this is unset. Running via `docker compose up` (docker-compose.yml)
# REQUIRES a real value — the compose file has no fallback default on
# purpose, so an unset key fails the backend's startup validation instead of
# silently encrypting secrets with a key anyone can read in this repo.
# Generate one with: openssl rand -hex 32
# APP_SECRETS_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_PORT=3000
